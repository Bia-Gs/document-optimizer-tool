@code {
    [CascadingParameter] public AppContextModel AppContext { get; set; }
    private List<PageTabs> Options = [PageTabs.Documentation, PageTabs.Settings];
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("DOTSpy.init", "#spyContainer", "#spyNav");
    }

    private async Task GoTo(string id) => await JS.InvokeVoidAsync("DOTSpy.scrollTo", id, "#spyContainer");

    // Helper para renderizar HTML vindo de resources (converte \n => <br />)
    private MarkupString Html(string key, bool convertLineBreaks = true)
    {
        var s = I18n[key] ?? string.Empty;
        if (convertLineBreaks)
        {
            s = s.Replace("\r\n", "\n").Replace("\n", "<br />");
        }
        return new MarkupString(s);
    }
}

